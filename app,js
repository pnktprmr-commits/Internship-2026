function formatName(name) {
  return name.trim().toUpperCase();
}


// ==========================================
// Task 2: student (Default Export equivalent)
// ==========================================
function printStudentInfo(name, course) {
  console.log(`[Default Export] Student Name: ${name}, Course: ${course}`);
}


// ==========================================
// Task 4: studentService (Business Logic)
// ==========================================
const students = [
  { id: 1, name: 'john doe', course: 'Mathematics' },
  { id: 2, name: 'jane smith', course: 'Physics' }
];

function getStudentCourse(id) {
  const student = students.find(s => s.id === id);
  if (!student) return 'Student not found';
  
  return `${formatName(student.name)} is enrolled in ${student.course}.`;
}


